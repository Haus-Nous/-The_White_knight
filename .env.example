# Upstash Redis / Vercel KV Database Credentials
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# Alternative Vercel KV aliases (auto-injected by Vercel Storage integration)
KV_REST_API_URL="https://your-upstash-redis-url.upstash.io"
KV_REST_API_TOKEN="your-upstash-redis-token"

# Session Cookie Secret
SESSION_SECRET="your-random-session-secret-key"

# AI Model Provider API Keys (Set at least one)
GROQ_API_KEY="gsk_your_free_groq_key"                  # Recommended: 100% Free at console.groq.com
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_key"       # Optional: Free tier at openrouter.ai
TOGETHER_API_KEY="your-together-ai-key"                # Optional: Together AI key
OPENAI_API_KEY="sk-your-openai-key"                    # Optional: OpenAI key
ANTHROPIC_API_KEY="sk-ant-your-anthropic-key"          # Optional: Anthropic key

# Model Overrides (Optional)
AI_MODEL="llama-3.3-70b-versatile"
AI_VISION_MODEL="meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8"

# Admin Setup Secret (Optional)
SETUP_SECRET="your-admin-setup-secret"
